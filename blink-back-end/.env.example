# Uniswap Trading API key (https://developers.uniswap.org/dashboard), used by the X ticker swap panel
UNISWAP_API_KEY=

# Intercepta (Web3 Antivirus) API key (https://intercepta.io), used for token and transaction security checks
INTERCEPTA_API_KEY=

# World ID (https://developer.world.org), used for kickbacks: tweet authors prove they are human to earn a fee on buys from their tweets.
# Create an external app, enable World ID 4.0 and create the action below. The signing key is shown once: paste it here only.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=earn-kickbacks
# "staging" pairs with the World ID Simulator (simulator.worldcoin.org); use "production" for the real World App
WORLD_ENVIRONMENT=staging
# Token for an open staging verification window (Developer Portal, lasts 24h). Not needed in production.
WORLD_STAGING_TOKEN=
