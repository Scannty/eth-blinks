{
  "manifest_version": 3,
  "name": "Ephi Blinks",
  "version": "1.1",
  "description": "Renders <blk URL blk> tags as interactive blockchain widgets.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*"
      ],
      "js": ["x-ticker-swap.js"]
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["sandbox.html", "sandbox.js", "vendor/ethers-5.7.2.umd.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
